# Admin blog — tanpa ini, /admin menolak semua login (fail-closed).
# Password untuk masuk halaman admin blog.
BLOG_ADMIN_PASSWORD=
# Secret untuk menandatangani cookie sesi (HMAC, min. 8 karakter).
# Opsional di dev (ada fallback lokal); WAJIB di produksi.

# Opsional — supaya simpan/hapus post dari Vercel bertahan di git
# (tanpa ini, admin menulis file lokal via fs — hanya untuk npm run dev).
GITHUB_TOKEN=
GITHUB_REPO=digia-dev/rendy
GITHUB_BRANCH=main

# Opsional — URL absolut untuk RSS & sitemap (default: VERCEL_URL / localhost).
NEXT_PUBLIC_SITE_URL=
